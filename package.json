{
  "name": "bootstrap-sass-docker",
  "version": "1.0.0",
"scripts": {
  "build-sass": "sass --load-path=node_modules --quiet-deps scss/main.scss:src/css/main.css --no-source-map",
  "watch-sass": "sass --watch --load-path=node_modules --quiet-deps scss/main.scss:src/css/main.css"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "sass": "^1.60.0"
  }
}